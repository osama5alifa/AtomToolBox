<UserControl x:Class="Atom.Toolbox.Desktop.Views.PageView"
             xmlns:ui="clr-namespace:Atom.Toolbox.Desktop.Ui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Atom.Toolbox.Desktop.Views"
             xmlns:items="clr-namespace:Atom.Toolbox.Desktop.ViewModels.Items">
    <UserControl.Resources>
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type items:PageSectionViewModel}">
            <StackPanel Margin="{Binding Margin}">
                <Border x:Name="Card" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,16">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="12,10,12,10" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Plain">
                    <Border Style="{StaticResource SectionHeaderBorder}"
                            Visibility="{Binding ShowTitle, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextDim}"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource TweakDesc}"
                               Visibility="{Binding ShowDescription, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,0,8" />
                    <ItemsControl x:Name="StackItems" ItemsSource="{Binding Items}" />
                    <ItemsControl x:Name="GridItems" ItemsSource="{Binding Items}" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCard}" Value="True">
                    <Setter TargetName="Card" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGrid}" Value="True">
                    <Setter TargetName="StackItems" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="GridItems" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer ui:ScrollReset.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,24" Focusable="False">
        <StackPanel>
            <Border Style="{StaticResource SectionHeaderBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Count}"
                               Visibility="{Binding CountText, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Intro}" Style="{StaticResource Intro}"
                       Visibility="{Binding Intro, Converter={StaticResource EmptyToCollapsed}}" />

            <Border Style="{StaticResource AdminWarning}"
                    Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource WarningText}"
                           Text="[!] MANY TWEAKS REQUIRE ADMIN — RUN APP AS ADMINISTRATOR FOR FULL EFFECT" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="12,10,12,10">
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Mono}"
                               Foreground="{DynamicResource TextDim}" />
                    <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="14,12,14,12">
                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Mono}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Toolbar}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                    Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,9,12,9">
                        <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource Mono}"
                                   Foreground="{DynamicResource TextDim}" />
                    </Border>
                    <ScrollViewer MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding PreviewText}" Margin="14,12,14,12"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" LineHeight="18" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <views:ConsolePanel DataContext="{Binding Console}"
                                Visibility="{Binding DataContext.HasConsole, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
