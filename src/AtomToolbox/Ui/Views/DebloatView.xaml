<UserControl x:Class="Atom.Toolbox.Desktop.Views.DebloatView"
             xmlns:ui="clr-namespace:Atom.Toolbox.Desktop.Ui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Atom.Toolbox.Desktop.ViewModels.Pages">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type pages:DebloatRowViewModel}">
            <Border Style="{StaticResource TweakRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource SquareCheck}" VerticalAlignment="Top" Margin="0,2,0,0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanRemove}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource TweakName}" />
                            <Border Padding="5,1,5,1" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    Margin="8,1,0,0" Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Badge}" Style="{StaticResource Mono}" FontSize="8" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource TweakDesc}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Mono}" FontSize="9" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Packages}" Style="{StaticResource Mono}" FontSize="9"
                                   Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pages:DebloatGroupViewModel}">
            <StackPanel Margin="0,0,0,16">
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextDim}"
                                   FontWeight="SemiBold" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Mono}" FontSize="9">
                            <Run Text="{Binding RemovableCount, Mode=OneWay}" />
                            <Run Text=" REMOVABLE" />
                        </TextBlock>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer ui:ScrollReset.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,24" Focusable="False">
        <StackPanel>
            <Border Style="{StaticResource SectionHeaderBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Count}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="10,8,12,8" Margin="0,0,0,12">
                <TextBlock Text="{Binding Intro}" Style="{StaticResource TweakDesc}" Margin="0" />
            </Border>

            <Border Style="{StaticResource AdminWarning}"
                    Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource WarningText}"
                           Text="[!] REMOVING WINDOWS APPS REQUIRES ADMIN — RUN APP AS ADMINISTRATOR" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel Margin="12,10,12,10">
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Mono}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource Warning}" />
                    <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" Margin="0,6,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Toolbar}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,10">
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="FILTER APPS..." Style="{StaticResource Mono}" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding FilterText, Converter={StaticResource EmptyToVisible}}" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <TextBlock Style="{StaticResource Mono}">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource Text}" />
                    <Run Text=" SELECTED" Foreground="{DynamicResource TextMuted}" />
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                           MaxWidth="640" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusTone}" Value="On">
                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Working">
                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ItemsControl ItemsSource="{Binding Groups}" />
            <TextBlock Text="{Binding EmptyMessage}" Margin="4,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TweakDesc}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
