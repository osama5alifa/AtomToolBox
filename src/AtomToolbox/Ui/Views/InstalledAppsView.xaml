<UserControl x:Class="Atom.Toolbox.Desktop.Views.InstalledAppsView"
             xmlns:ui="clr-namespace:Atom.Toolbox.Desktop.Ui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Atom.Toolbox.Desktop.ViewModels.Pages">
    <UserControl.Resources>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="10,7,10,7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type pages:InstalledAppRowViewModel}">
            <Border Style="{StaticResource TweakRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource TweakDesc}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding ActionText}" Style="{StaticResource GhostButton}"
                            Command="{Binding UninstallCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            MinWidth="96" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer ui:ScrollReset.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,24" Focusable="False">
        <StackPanel>
            <Border Style="{StaticResource SectionHeaderBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Count}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource TabButton}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,10,0,8">
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="FILTER APPS..." Style="{StaticResource Mono}" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding FilterText, Converter={StaticResource EmptyToVisible}}" />
            </Grid>

            <TextBlock Style="{StaticResource Mono}" Margin="0,0,0,8">
                <Run Text="SHOWING: " Foreground="{DynamicResource TextMuted}" />
                <Run Text="{Binding ShowingText, Mode=OneWay}" Foreground="{DynamicResource Text}" />
            </TextBlock>

            <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource BareList}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
            <TextBlock Text="NO APPLICATIONS FOUND." Margin="4,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TweakDesc}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="LOAD MORE" Style="{StaticResource GhostButton}" HorizontalAlignment="Center"
                    Margin="0,10,0,0" Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
