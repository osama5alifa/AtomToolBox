<UserControl x:Class="Atom.Toolbox.Desktop.Views.PowerPlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Atom.Toolbox.Desktop.Ui"
             xmlns:pages="clr-namespace:Atom.Toolbox.Desktop.ViewModels.Pages">
    <UserControl.Resources>
        <Style x:Key="PlanRow" TargetType="Border" BasedOn="{StaticResource TweakRow}">
            <Setter Property="Padding" Value="14,12,14,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TextDim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer ui:ScrollReset.IsEnabled="True" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24" Focusable="False">
        <StackPanel>
            <Border Style="{StaticResource SectionHeaderBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Count}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Intro}" Style="{StaticResource Intro}" />

            <Border Style="{StaticResource AdminWarning}"
                    Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource WarningText}"
                           Text="[!] ACTIVATING POWER PLANS REQUIRES ADMIN — RUN APP AS ADMINISTRATOR" />
            </Border>

            <!-- Active scheme summary -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <TextBlock Text="ACTIVE SCHEME" Style="{StaticResource CardTitle}" />
                    </Border>
                    <Grid Margin="18,14,18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveName}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ActiveGuid}" Style="{StaticResource Mono}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="8,4,8,4" BorderBrush="{DynamicResource Success}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE" Style="{StaticResource Mono}"
                                       Foreground="{DynamicResource Success}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Plan switcher -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AVAILABLE POWER PLANS" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <Button Content="REFRESH" Style="{StaticResource SmallGhostButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Command="{Binding RefreshCommand}" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="16,12,16,14">
                        <Border Style="{StaticResource Card}" Background="{DynamicResource Bg}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,10">
                            <StackPanel Margin="12,9,12,9">
                                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource TextDim}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Plans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:PowerPlanRowViewModel}">
                                    <Border Style="{StaticResource PlanRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsName}"
                                                               FontWeight="SemiBold" />
                                                    <Border Padding="5,1,5,1" BorderBrush="{DynamicResource Border}"
                                                            BorderThickness="1" Margin="8,1,0,0"
                                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="BUILT-IN" Style="{StaticResource Mono}" FontSize="8" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Guid}" Style="{StaticResource Mono}"
                                                           FontSize="9" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="7,3,7,3" BorderBrush="{DynamicResource Success}"
                                                    BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="ACTIVE" Style="{StaticResource Mono}" FontSize="8"
                                                           Foreground="{DynamicResource Success}" />
                                            </Border>
                                            <Button Grid.Column="2" Content="{Binding ActionText}"
                                                    Style="{StaticResource GhostButton}" MinWidth="96"
                                                    Command="{Binding ActivateCommand}" IsEnabled="{Binding CanActivate}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="NO POWER PLANS WERE RETURNED BY WINDOWS."
                                   Style="{StaticResource TweakDesc}" Margin="2,8,0,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Full legacy ready-made plan library (plan switching only) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="READY-MADE POWER PLANS" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding BundledCountText}" Style="{StaticResource Count}" Margin="0,11,0,0" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding BundledPlans}" Margin="16,12,16,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:BundledPlanRowViewModel}">
                                <Border Style="{StaticResource PlanRow}" Padding="14,11,14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource TweakDesc}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionText}"
                                                Style="{StaticResource GhostButton}" MinWidth="86"
                                                Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource TweakDesc}" Margin="0,14,0,0"
                       Text="POWER PLANS ARE PROVIDED BY WINDOWS. ACTIVATION APPLIES IMMEDIATELY AND PERSISTS ACROSS REBOOTS." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
