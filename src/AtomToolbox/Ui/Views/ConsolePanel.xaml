<UserControl x:Class="Atom.Toolbox.Desktop.Views.ConsolePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:Atom.Toolbox.Desktop.ViewModels.Items">
    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,8,12,8">
                <Grid>
                    <TextBlock Text="&gt; EXECUTION LOG" Style="{StaticResource Mono}" Foreground="{DynamicResource TextDim}" />
                    <Button Content="CLEAR" Style="{StaticResource SmallGhostButton}" HorizontalAlignment="Right"
                            Command="{Binding ClearCommand}" />
                </Grid>
            </Border>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" MinHeight="80" MaxHeight="200"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="LogText" Text="{Binding Text}" Margin="12,10,12,10"
                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" LineHeight="16" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
