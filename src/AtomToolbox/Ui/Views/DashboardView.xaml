<UserControl x:Class="Atom.Toolbox.Desktop.Views.DashboardView"
             xmlns:ui="clr-namespace:Atom.Toolbox.Desktop.Ui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:Atom.Toolbox.Desktop.ViewModels.Items">
    <ScrollViewer ui:ScrollReset.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,24" Focusable="False">
        <StackPanel>
            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            </Border>

            <Border Style="{StaticResource AdminWarning}"
                    Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource WarningText}"
                           Text="[!] SOME OPERATIONS REQUIRE ADMIN — RUN APP AS ADMINISTRATOR" />
            </Border>

            <ItemsControl ItemsSource="{Binding Toolbar}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:MetricCardViewModel}">
                        <Border Style="{StaticResource Card}" Padding="18,16,20,18" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Value}" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="{Binding Sub}" Style="{StaticResource MetricSub}"
                                           Visibility="{Binding Sub, Converter={StaticResource EmptyToCollapsed}}" />
                                <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Percent, Mode=OneWay}"
                                             Maximum="100" Margin="0,12,0,0"
                                             Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,8,0,16">
                <TextBlock Text="SYSTEM INFORMATION" FontSize="11" Foreground="{DynamicResource TextDim}"
                           FontWeight="SemiBold" />
            </Border>

            <ItemsControl ItemsSource="{Binding InfoCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:KeyValueViewModel}">
                        <Border Style="{StaticResource Card}" Padding="14,12,14,12" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Value}" Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
