<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:items="clr-namespace:Atom.Toolbox.Desktop.ViewModels.Items"
                    xmlns:pages="clr-namespace:Atom.Toolbox.Desktop.ViewModels.Pages"
                    xmlns:views="clr-namespace:Atom.Toolbox.Desktop.Views"
                    xmlns:ui="clr-namespace:Atom.Toolbox.Desktop.Ui">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <ui:InverseBooleanConverter x:Key="InverseBool" />
    <ui:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <ui:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <ui:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <ui:EmptyToVisibleConverter x:Key="EmptyToVisible" />

    <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate DataType="{x:Type items:ToggleRowViewModel}">
        <Border Style="{StaticResource TweakRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TweakName}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource TweakDesc}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.Name="{Binding Name}"
                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                  Command="{Binding ToggleCommand}"
                                  IsEnabled="{Binding CanAct}" />
                    <TextBlock Text="{Binding StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Status}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="On">
                                        <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Working">
                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Failed">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type items:ActionRowViewModel}">
        <Border Style="{StaticResource TweakRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TweakName}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource TweakDesc}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Status}"
                           Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}" />
                <Button Grid.Column="2" Content="{Binding ActionText}" Style="{StaticResource GhostButton}"
                        Command="{Binding Command}" IsEnabled="{Binding CanAct}"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type items:ProcessRowViewModel}">
        <Border Style="{StaticResource TweakRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TweakName}" />
                    <TextBlock Text="{Binding Memory}" Style="{StaticResource TweakDesc}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Status}"
                               Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="KILL" Style="{StaticResource SmallGhostButton}" Margin="0,0,6,0"
                                Command="{Binding KillCommand}" IsEnabled="{Binding CanControl}" />
                        <Button Content="BLOCK" Style="{StaticResource SmallGhostButton}"
                                Command="{Binding BlockCommand}" IsEnabled="{Binding CanControl}" />
                    </StackPanel>
                    <TextBlock Text="SYSTEM">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Status}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type items:SettingsRowViewModel}">
        <Border Style="{StaticResource TweakRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsName}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsDesc}"
                               Visibility="{Binding Description, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="8,3,8,3" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            Margin="0,0,8,0"
                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TagText}" Style="{StaticResource Mono}" Foreground="{DynamicResource Text}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Actions}" Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type items:ActionButtonViewModel}">
        <Button Content="{Binding Label}" Style="{StaticResource ChoiceButton}"
                Command="{Binding Command}" IsEnabled="{Binding IsEnabled}" Margin="0,0,6,0" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type items:ButtonGridItemViewModel}">
        <Button Content="{Binding Label}" Style="{StaticResource ShortcutButton}"
                Command="{Binding Command}" Margin="0,0,8,8" MinWidth="160" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type items:AppRowViewModel}">
        <Border Style="{StaticResource TweakRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsName}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Status}"
                           Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}" />
                <Button Grid.Column="2" Content="{Binding ActionText}" Style="{StaticResource GhostButton}"
                        Command="{Binding Command}" IsEnabled="{Binding CanAct}" MinWidth="80" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type items:MessageViewModel}">
        <TextBlock Text="{Binding Text}" Style="{StaticResource TweakDesc}" Margin="12,10,12,10" FontSize="10" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type items:PageViewModel}">
        <views:PageView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:PowerPlansViewModel}">
        <views:PowerPlansView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:InstalledAppsViewModel}">
        <views:InstalledAppsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:DebloatViewModel}">
        <views:DebloatView />
    </DataTemplate>
</ResourceDictionary>
