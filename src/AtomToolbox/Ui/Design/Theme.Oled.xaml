<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <SolidColorBrush x:Key="Bg" Color="#000000" />
    <SolidColorBrush x:Key="Panel" Color="#050505" />
    <SolidColorBrush x:Key="Border" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextDim" Color="#A2A2A2" />
    <SolidColorBrush x:Key="TextMuted" Color="#6E6E6E" />
    <SolidColorBrush x:Key="TextFaint" Color="#303030" />
    <SolidColorBrush x:Key="Hover" Color="#101010" />
    <SolidColorBrush x:Key="Toggle" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Success" Color="#33AA33" />
    <SolidColorBrush x:Key="Danger" Color="#CC3333" />
    <SolidColorBrush x:Key="Warning" Color="#C9A84A" />
    <SolidColorBrush x:Key="WarnBg" Color="#1A1600" />
    <SolidColorBrush x:Key="WarnBorder" Color="#554400" />
    <SolidColorBrush x:Key="WarnText" Color="#AA8800" />
    <SolidColorBrush x:Key="Scrim" Color="#8C000000" />
    <SolidColorBrush x:Key="CloseHover" Color="#990000" />
</ResourceDictionary>
