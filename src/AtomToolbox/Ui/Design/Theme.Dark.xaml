<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <SolidColorBrush x:Key="Bg" Color="#161616" />
    <SolidColorBrush x:Key="Panel" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Border" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Text" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextDim" Color="#ADADAD" />
    <SolidColorBrush x:Key="TextMuted" Color="#7B7B7B" />
    <SolidColorBrush x:Key="TextFaint" Color="#454545" />
    <SolidColorBrush x:Key="Hover" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Toggle" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Success" Color="#33AA33" />
    <SolidColorBrush x:Key="Danger" Color="#CC3333" />
    <SolidColorBrush x:Key="Warning" Color="#C9A84A" />
    <SolidColorBrush x:Key="WarnBg" Color="#1A1600" />
    <SolidColorBrush x:Key="WarnBorder" Color="#554400" />
    <SolidColorBrush x:Key="WarnText" Color="#AA8800" />
    <SolidColorBrush x:Key="Scrim" Color="#8C000000" />
    <SolidColorBrush x:Key="CloseHover" Color="#990000" />
</ResourceDictionary>
